DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/learnova
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# PROXY_COUNT=1   # when deployed behind one trusted reverse proxy (enables X-Forwarded-For)

# AI Tutor (Stage 11)
# AI_PROVIDER=local    # rule-based tutor — works out of the box with no API key
AI_PROVIDER=openai   # real responses via OpenAI (needs an API key)
AI_API_KEY=
AI_MODEL=gpt-4o-mini