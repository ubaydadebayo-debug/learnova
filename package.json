{
  "name": "learnova",
  "version": "0.1.0",
  "private": true,
  "description": "Learnova — AI-powered Learning Management System",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "db:validate": "npm --prefix server run prisma:validate",
    "db:generate": "npm --prefix server run prisma:generate",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:seed": "npm --prefix server run prisma:seed",
    "db:studio": "npm --prefix server run prisma:studio",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}